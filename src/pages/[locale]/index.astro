---
import BaseLayout from '@layouts/BaseLayout.astro';
import { 
  ThemeSwitcher,
  LanguageSelector
 } from '@components/base';
import dictionary from '@i18n/portfolio.json' with { type : "json" }

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'ar' } },
  ];
}

const { locale } = Astro.params;


const ui = dictionary[locale as keyof typeof dictionary] || dictionary.en;
---

<BaseLayout title={ui.title} description="Interactive 3D Graphics Platform">
  
  <strong slot="nav-logo">&ltZakaria Elalaoui /&gt</strong>
  
  <ul slot="nav-links" class="nav-links-list">
    <li><a href={`/${locale}#home-view`} class="is-active">{ui.navHome}</a></li>
    <li><a href={`/${locale}#about-view`}>{ui.navAbout}</a></li>
    <li><a href={`/${locale}#projects-view`}>{ui.navProjects}</a></li>
    <ThemeSwitcher client:load/>
    <LanguageSelector />
  </ul>

  <!-- Main View Component Blocks -->
  <section id="home-view" class="portfolio-section section-hero">
    <div class="layout-container">
      <h1>{ui.heroTitle}</h1>
    </div>
  </section>

  <section id="about-view" class="portfolio-section section-about">
    <div class="layout-container">
      <h2>{ui.aboutTitle}</h2>
    </div>
  </section>

  <section id="projects-view" class="portfolio-section section-projects">
    <div class="layout-container">
      <h2>{ui.projectsTitle}</h2>
    </div>
  </section>

  <script>
    
  </script>

  <style is:global>
    .portfolio-section {
      min-height: 100vh;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-block: calc(var(--nav-height) + 2rem) 4rem;
      transition: background-color var(--transition-speed) var(--transition-timing), color var(--transition-speed) var(--transition-timing);
    }
    .section-hero { 
      background-color: var(--bg-hero);
      color: var(--text-hero); 
    }
    .section-about { 
      background-color: var(--bg-about);
      color: var(--text-about); 
    }
    .section-projects { 
      background-color: var(--bg-projects);
      color: var(--text-projects); 
    }
    @media (min-width: 768px) {
        .portfolio-section { 
          padding-block: var(--nav-height) 0; 
        }
      }
  </style>

  <script>
          // Target selection links lookup for highlighted tabs active tracking
      const navLinks = document.querySelectorAll('#mobile-menu-drawer a');
      const targetSections = document.querySelectorAll('#home-view, #about-view, #projects-view');

      const observerOptions = {
        root: null,
        rootMargin: '-40% 0px -50% 0px',
        threshold: 0
      };

      const observerCallback = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const sectionId = entry.target.getAttribute('id');
            navLinks.forEach((link) => {
              const hrefAttribute = link.getAttribute('href');
              hrefAttribute && hrefAttribute.endsWith(`#${sectionId}`) 
                ? link.classList.add('is-active')
                : link.classList.remove('is-active');
            });
          }
        });
      };

      const sectionObserver = new IntersectionObserver(observerCallback, observerOptions);
      targetSections.forEach((section) => sectionObserver.observe(section));
  </script>

</BaseLayout>
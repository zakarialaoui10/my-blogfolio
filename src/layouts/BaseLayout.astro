---
import { 
  GlobalSearch,
  MobileNav,
} from '@components/base';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Dynamic Adaptive Platform" } = Astro.props;
const { currentLocale } = Astro; 

const isRTL = currentLocale === 'ar';
const dir = isRTL ? 'rtl' : 'ltr';
---

<!DOCTYPE html>
<html lang={currentLocale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <style is:global>
      @import url("@styles/root.css");
      @import url("@components/base/ThemeSwitcher/index.css");
      
      body.search-modal-open {
        overflow: hidden;
      }

      .nav-header {
        position: fixed;
        top: 0;
        inset-inline-start: 0;
        width: 100%;
        height: var(--nav-height);
        z-index: 100;
        display: flex;
        align-items: center;
        background-color: transparent;
        color: var(--text-nav);
        transition: background-color var(--transition-speed) var(--transition-timing), color var(--transition-speed) var(--transition-timing);
      }

      .nav-header.is-scrolled {
        background-color: var(--bg-nav);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border-nav);
      }

      .nav-icon-btn {
        background: transparent;
        border: none;
        color: var(--text-nav);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 6px;
        transition: color var(--transition-speed) var(--transition-timing), background-color var(--transition-speed) var(--transition-timing);
      }

      .nav-icon-btn:hover {
        background-color: rgba(125, 125, 125, 0.1);
      }

      .layout-container {
        width: 100%;
        max-width: 1200px;
        margin-inline: auto;
        padding-inline: 1.5rem;
      }

      .flex-row-between {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
      }

      .nav-controls {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .nav-links-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        list-style: none;
        width: 100%;
        position: relative;
        align-items: center;
      }

      .nav-links-list a {
        color: inherit;
        text-decoration: none;
        font-weight: 500;
        display: block;
        width: 100%;
        transition: color var(--transition-speed) var(--transition-timing);
      }

      .nav-links-list a.is-active {
        color: var(--accent-color); 
      }

      main{
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
      }
      @media (min-width: 768px) {
        .layout-container { padding-inline: 3rem; }
        .nav-links-list {
          flex-direction: row;
          gap: 2rem;
          margin-inline-end: 1rem;
        }
      }
    </style>

    <script is:inline>
      const currentPersistedTheme = () => {
        const localChoice = localStorage.getItem('theme');
        if (localChoice) return localChoice;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      document.documentElement.setAttribute('data-theme', currentPersistedTheme());
    </script>
  </head>
  <body>
    
    <header id="portfolio-navbar" class="nav-header">
      <div class="layout-container flex-row-between">
        <slot name="nav-logo"><strong>Core.</strong></slot>
        
        <div class="nav-controls">
          <GlobalSearch />
          <MobileNav>
            <slot name="nav-links" />
          </MobileNav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      const header = document.getElementById('portfolio-navbar');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) header?.classList.add('is-scrolled');
        else header?.classList.remove('is-scrolled');
      });
    </script>
  </body>
</html>